# Copy to .env and fill in. .env is gitignored; never commit a real key.
#   cp .env.example .env
#
# streamlit run app.py reads .env by itself. For the CLI and benchmark, load it first:
#   set -a; source .env; set +a
#
# Without a key, the app uses fake agents (no API calls). For the CLI, pass --fake:
#   python coordinator.py --toy --fake

# Agent LLM API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
